<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue formulaire Plan -->
        <record id="saas_plan_form" model="ir.ui.view">
            <field name="name">saas.plan.form</field>
            <field name="model">saas.plan</field>
            <field name="arch" type="xml">
                <form string="Plan SaaS">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-check">
                                <field name="active" widget="boolean_button" options='{"terminology": {"string_true": "Actif", "string_false": "Inactif"}}'/>
                            </button>
                            <button type="object" name="action_view_subscriptions" class="oe_stat_button" icon="fa-users">
                                <field name="subscription_count" widget="statinfo" string="Souscriptions"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nom du Plan"/></h1>
                        </div>
                        <group>
                            <group string="Informations Générales">
                                <field name="code" placeholder="ex: STARTER"/>
                                <field name="description" placeholder="Description du plan"/>
                                <field name="sequence"/>
                            </group>
                            <group string="Tarification">
                                <field name="monthly_price"/>
                                <field name="yearly_price"/>
                                <field name="currency_id"/>
                            </group>
                        </group>
                        <group string="Limites de Ressources">
                            <group>
                                <field name="max_storage_gb"/>
                                <field name="max_users"/>
                                <field name="max_databases"/>
                            </group>
                        </group>
                        <group string="Fonctionnalités">
                            <group>
                                <field name="included_modules"/>
                                <field name="api_access"/>
                                <field name="priority_support"/>
                            </group>
                            <group>
                                <field name="advanced_reports"/>
                                <field name="automation_workflows"/>
                                <field name="custom_domain"/>
                            </group>
                            <group>
                                <field name="sso_enabled"/>
                                <field name="two_factor_auth"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes" placeholder="Notes internes" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Vue liste Plan -->
        <record id="saas_plan_tree" model="ir.ui.view">
            <field name="name">saas.plan.tree</field>
            <field name="model">saas.plan</field>
            <field name="arch" type="xml">
                <tree string="Plans SaaS" decoration-muted="not active">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="monthly_price" sum="Prix Mensuel"/>
                    <field name="yearly_price"/>
                    <field name="max_storage_gb"/>
                    <field name="max_users"/>
                    <field name="subscription_count"/>
                    <field name="active" widget="boolean"/>
                </tree>
            </field>
        </record>

        <!-- Vue recherche Plan -->
        <record id="saas_plan_search" model="ir.ui.view">
            <field name="name">saas.plan.search</field>
            <field name="model">saas.plan</field>
            <field name="arch" type="xml">
                <search string="Plans SaaS">
                    <field name="name" string="Nom"/>
                    <field name="code" string="Code"/>
                    <filter name="active" string="Actifs" domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Inactifs" domain="[('active', '=', False)]"/>
                    <separator/>
                    <group expand="0" string="Grouper par">
                        <filter name="group_by_active" string="Statut" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action Plan -->
        <record id="action_saas_plan" model="ir.actions.act_window">
            <field name="name">Plans</field>
            <field name="res_model">saas.plan</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="saas_plan_tree"/>
            <field name="search_view_id" ref="saas_plan_search"/>
        </record>
    </data>
</odoo>
