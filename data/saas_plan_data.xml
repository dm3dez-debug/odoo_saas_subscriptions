<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Création des séquences -->
        <record id="seq_saas_subscription" model="ir.sequence">
            <field name="name">SaaS Subscription Sequence</field>
            <field name="code">saas.subscription</field>
            <field name="prefix">SUB/%(y)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Plans par défaut -->
        <record id="plan_starter" model="saas.plan">
            <field name="name">Plan Starter</field>
            <field name="code">STARTER</field>
            <field name="description">Plan d'entrée de gamme pour les petites entreprises</field>
            <field name="sequence">1</field>
            <field name="active">True</field>
            <field name="monthly_price">29.99</field>
            <field name="yearly_price">299.90</field>
            <field name="max_storage_gb">10</field>
            <field name="max_users">5</field>
            <field name="max_databases">1</field>
            <field name="included_modules">0</field>
            <field name="api_access">False</field>
            <field name="priority_support">False</field>
            <field name="advanced_reports">False</field>
            <field name="automation_workflows">False</field>
            <field name="custom_domain">False</field>
            <field name="sso_enabled">False</field>
            <field name="two_factor_auth">False</field>
        </record>

        <record id="plan_professional" model="saas.plan">
            <field name="name">Plan Professionnel</field>
            <field name="code">PROFESSIONAL</field>
            <field name="description">Plan complet avec toutes les fonctionnalités de base</field>
            <field name="sequence">2</field>
            <field name="active">True</field>
            <field name="monthly_price">79.99</field>
            <field name="yearly_price">799.90</field>
            <field name="max_storage_gb">50</field>
            <field name="max_users">25</field>
            <field name="max_databases">2</field>
            <field name="included_modules">0</field>
            <field name="api_access">True</field>
            <field name="priority_support">True</field>
            <field name="advanced_reports">True</field>
            <field name="automation_workflows">True</field>
            <field name="custom_domain">False</field>
            <field name="sso_enabled">False</field>
            <field name="two_factor_auth">True</field>
        </record>

        <record id="plan_enterprise" model="saas.plan">
            <field name="name">Plan Entreprise</field>
            <field name="code">ENTERPRISE</field>
            <field name="description">Plan premium avec toutes les fonctionnalités avancées</field>
            <field name="sequence">3</field>
            <field name="active">True</field>
            <field name="monthly_price">199.99</field>
            <field name="yearly_price">1999.00</field>
            <field name="max_storage_gb">200</field>
            <field name="max_users">100</field>
            <field name="max_databases">5</field>
            <field name="included_modules">0</field>
            <field name="api_access">True</field>
            <field name="priority_support">True</field>
            <field name="advanced_reports">True</field>
            <field name="automation_workflows">True</field>
            <field name="custom_domain">True</field>
            <field name="sso_enabled">True</field>
            <field name="two_factor_auth">True</field>
        </record>
    </data>
</odoo>
